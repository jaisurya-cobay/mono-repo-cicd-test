{
  "$schema": "./node_modules/nx/schemas/nx-schema.json",
  "defaultBase": "qa",
  "analytics": false,
  "neverConnectToCloud": true,
  "namedInputs": {
    "default": ["{projectRoot}/**/*"],
    "production": ["default", "!{projectRoot}/test/**", "!{projectRoot}/**/*.md"]
  },
  "targetDefaults": {
    "lint": { "cache": true, "inputs": ["default"] },
    "typecheck": { "cache": true, "inputs": ["default", "^production"] },
    "test": { "cache": true, "inputs": ["default", "^production"] },
    "integration": { "cache": true, "inputs": ["default", "^production"] },
    "build": { "cache": true, "dependsOn": ["^build"], "inputs": ["production", "^production", { "env": "MODE" }, { "env": "GIT_SHA" }], "outputs": ["{projectRoot}/dist"] }
  }
}
